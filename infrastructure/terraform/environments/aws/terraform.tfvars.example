aws_region  = "us-east-1"
environment = "staging"

# Network
vpc_cidr        = "10.0.0.0/16"
azs             = ["us-east-1a", "us-east-1b"]
public_subnets  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnets = ["10.0.10.0/24", "10.0.20.0/24"]

# EKS
kubernetes_version  = "1.30"
node_instance_types = ["t3.medium"]   # use m5.large or c5.xlarge for production
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 4

# Services (one ECR repo per entry)
services = ["seed", "api-gateway", "analytics", "alert"]
